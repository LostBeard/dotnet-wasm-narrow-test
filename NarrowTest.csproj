<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      Three builds of the same code:
        (default)               the interpreter with its hot-path compiler (the "jiterpreter"): what a plain Blazor WebAssembly publish is
        -p:Jiterpreter=false    the interpreter alone: the control
        -p:Aot=true             ahead-of-time compiled (needs the wasm-tools workload)
    -->
    <BlazorWebAssemblyJiterpreter Condition="'$(Jiterpreter)' == 'false'">false</BlazorWebAssemblyJiterpreter>
    <RunAOTCompilation Condition="'$(Aot)' == 'true'">true</RunAOTCompilation>
    <DefineConstants Condition="'$(Jiterpreter)' == 'false'">$(DefineConstants);JITERPRETER_OFF</DefineConstants>
    <DefineConstants Condition="'$(Aot)' == 'true'">$(DefineConstants);AOT_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
  </ItemGroup>

</Project>
